@page "/usuarios"
@using sharpness_sharp.Data
@inject ApplicationAuthDbContext _dbService
<h3>Lista de Usuarios</h3>
<div>
    <div class="row">
        @foreach (ApplicationUser usuario in lstUsuarios)
        {
            <div class="col-md-4 mb-4">
                <div class="card h-100">
                    <div class="card-body">
                        <h5 class="card-title">@usuario.UserName</h5>
                        <p class="card-text"><strong>Email:</strong> @usuario.Email</p>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@code {

    private List<ApplicationUser> lstUsuarios = new List<ApplicationUser>();

    protected override Task OnInitializedAsync()
    {
        lstUsuarios = _dbService.Users.ToList();
        return base.OnInitializedAsync();
    }
    private Usuario newUser = new();


    private class Usuario
    {
        public string? UserName { get; set; }

        public string? Email { get; set; }

        public Usuario(string nombre, string email)
        {
            UserName = nombre;
            Email = email;
        }
        public Usuario()
        {

        }
    }
}