@page "/usuarios"

<h3>Lista de Usuarios</h3>
<div>
    <div class="row">
        @foreach (var usuario in lstUsuarios)
        {
            <div class="col-md-4 mb-4">
                <div class="card h-100">
                    <img src="@usuario.Imagen" class="card-img-top" alt="@usuario.Nombre" />
                    <div class="card-body">
                        <h5 class="card-title">@usuario.Nombre @usuario.Apellido</h5>
                        <p class="card-text"><strong>Email:</strong> @usuario.Email</p>
                        <p class="card-text"><strong>Teléfono:</strong> @usuario.Telefono</p>
                        <p class="card-text"><strong>Carrera:</strong> @usuario.Carrera</p>
                        <p class="card-text"><strong>Edad:</strong> @usuario.Edad años</p>
                        <p class="card-text"><strong>Estatura:</strong> @usuario.Estatura m</p>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

