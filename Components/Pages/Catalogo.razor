using Components/CoffeCard.razor
@page "/catalogo"

<div class="min-h-screen bg-[#FBF5EC] font-sans px-6 py-10 md:px-10">

    <header class="max-w-7xl mx-auto text-center mb-12 bg-[#1D3F6E] rounded-3xl px-6 py-12 shadow-lg">
        <p class="text-xs uppercase tracking-[0.3em] text-[#F29A4A] mb-3">Catálogo</p>
        <h1 class="font-serif text-4xl md:text-5xl font-semibold text-[#FBF5EC] mb-4">Nuestro Menú</h1>
        <div class="flex items-center justify-center gap-4 mb-4">
            <span class="h-px w-16 bg-[#E8751A]"></span>
            <span class="text-lg">☕</span>
            <span class="h-px w-16 bg-[#E8751A]"></span>
        </div>
        <p class="text-[#C9D7EA]">Elige tu café favorito entre nuestras @lstCafes.Count opciones.</p>
    </header>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6 max-w-7xl mx-auto">
        @foreach (Cafe cafe in lstCafes)
        {
            <CoffeCard Imagen="@cafe.Imagen" NombreCafe="@cafe.NombreCafe" DescripcionCafe="@cafe.DescripcionCafe" PrecioCafe="@cafe.PrecioCafe"></CoffeCard>
        }
    </div>

    <footer class="mt-12 text-center text-xs uppercase tracking-widest text-[#8A6A4F]">
        Precios en bolivianos (Bs.)
    </footer>

</div>


