@page "/catalogo"
@using sharpness_sharp.Components.UIComponents
@using sharpness_sharp.Data
@using sharpness_sharp.Data.Models
@inject ApplicationAuthDbContext _dbService

<EditForm FormName="agregar-cafe" Model="@newCafe" OnSubmit="AgregarCafe">
    <InputText @bind-Value="@newCafe.Imagen" class="border-2 px-2" placeholder="Introduce la url de la imagen"/>
    <InputText @bind-Value="@newCafe.NombreCafe" class="border-2 px-2" placeholder="Introduce el nombre del café"/>
    <InputText @bind-Value="@newCafe.DescripcionCafe" class="border-2 px-2" placeholder="Introduce la descripción del café"/>
    <InputNumber @bind-Value="@newCafe.PrecioCafe" class="border-2 px-2" placeholder="Introduce el precio del café"/>
    <button type="submit" class="border-2">Guardar</button>
</EditForm>
<div class="min-h-screen bg-[#FBF5EC] font-sans px-6 py-10 md:px-10">

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6 max-w-7xl mx-auto">
        @foreach (Cafe cafe in lstCafes)
        {
            <CoffeCard Imagen="@cafe.Imagen"
                       NombreCafe="@cafe.NombreCafe"
                       DescripcionCafe="@cafe.DescripcionCafe"
                       PrecioCafe="@cafe.PrecioCafe"></CoffeCard>
        }
    </div>

</div>


@code {

    private Cafe newCafe = new();
    private List<Cafe> lstCafes = new();

    protected override Task OnInitializedAsync()
    {
        lstCafes = _dbService.Cafes.ToList();
        return base.OnInitializedAsync();
    }

    private Task AgregarCafe()
    {
        _dbService.Cafes.Add(newCafe);
        _dbService.SaveChanges();
       return Task.CompletedTask;
    }
}